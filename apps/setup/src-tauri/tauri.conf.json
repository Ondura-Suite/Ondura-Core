{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ondura Setup",
  "mainBinaryName": "ondura-setup",
  "version": "0.1.6",
  "identifier": "de.mirranet.ondura.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ondura Setup",
        "width": 640,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "publisher": "MirraNET",
    "copyright": "© 2026 MirraNET",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
