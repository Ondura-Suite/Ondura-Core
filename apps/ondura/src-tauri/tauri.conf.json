{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ondura",
  "mainBinaryName": "ondura",
  "version": "0.1.0",
  "identifier": "de.mirranet.ondura",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: cid: https: http:; font-src 'self' data:; frame-src 'self' about: data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "MirraNET",
    "homepage": "https://github.com/Ondura-Suite/Ondura-Core",
    "copyright": "© 2026 Niklas Linz (MirraNET)",
    "category": "Productivity",
    "shortDescription": "Office-Suite: E-Mail, Kalender, Textverarbeitung, Tabellen und Präsentationen",
    "longDescription": "Ondura ist eine Office-Suite für Windows und Linux: Ondura Mail mit Kalender, Kontakten und Aufgaben für Microsoft 365, Exchange, IMAP und CalDAV/CardDAV sowie Ondura Text, Tabellen und Präsentation für Microsoft-Office- und OpenDocument-Dateien.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/apps/mail.ico": "icons/mail.ico",
      "icons/apps/text.ico": "icons/text.ico",
      "icons/apps/sheets.ico": "icons/sheets.ico",
      "icons/apps/slides.ico": "icons/slides.ico",
      "../../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../../../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi",
        "installMode": "perMachine",
        "languages": [
          "German",
          "English",
          "French"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Ondura",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp"
      }
    },
    "linux": {
      "deb": {
        "section": "misc",
        "files": {
          "/usr/share/applications/ondura-mail.desktop": "linux/ondura-mail.desktop",
          "/usr/share/icons/hicolor/256x256/apps/ondura-mail.png": "icons/apps/mail.png",
          "/usr/share/applications/ondura-text.desktop": "linux/ondura-text.desktop",
          "/usr/share/icons/hicolor/256x256/apps/ondura-text.png": "icons/apps/text.png",
          "/usr/share/applications/ondura-sheets.desktop": "linux/ondura-sheets.desktop",
          "/usr/share/icons/hicolor/256x256/apps/ondura-sheets.png": "icons/apps/sheets.png",
          "/usr/share/applications/ondura-slides.desktop": "linux/ondura-slides.desktop",
          "/usr/share/icons/hicolor/256x256/apps/ondura-slides.png": "icons/apps/slides.png",
          "/usr/lib/systemd/system/ondura-update.path": "linux/ondura-update.path",
          "/usr/lib/systemd/system/ondura-update.service": "linux/ondura-update.service"
        },
        "postInstallScript": "linux/postinst.sh",
        "preRemoveScript": "linux/prerm.sh"
      },
      "rpm": {
        "files": {
          "/usr/share/applications/ondura-mail.desktop": "linux/ondura-mail.desktop",
          "/usr/share/icons/hicolor/256x256/apps/ondura-mail.png": "icons/apps/mail.png",
          "/usr/share/applications/ondura-text.desktop": "linux/ondura-text.desktop",
          "/usr/share/icons/hicolor/256x256/apps/ondura-text.png": "icons/apps/text.png",
          "/usr/share/applications/ondura-sheets.desktop": "linux/ondura-sheets.desktop",
          "/usr/share/icons/hicolor/256x256/apps/ondura-sheets.png": "icons/apps/sheets.png",
          "/usr/share/applications/ondura-slides.desktop": "linux/ondura-slides.desktop",
          "/usr/share/icons/hicolor/256x256/apps/ondura-slides.png": "icons/apps/slides.png",
          "/usr/lib/systemd/system/ondura-update.path": "linux/ondura-update.path",
          "/usr/lib/systemd/system/ondura-update.service": "linux/ondura-update.service"
        },
        "postInstallScript": "linux/postinst.sh",
        "preRemoveScript": "linux/prerm.sh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "docx"
        ],
        "name": "Ondura.Text.docx",
        "description": "Word-Dokument",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": [
          "xlsx"
        ],
        "name": "Ondura.Tabellen.xlsx",
        "description": "Excel-Arbeitsmappe",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": [
          "pptx"
        ],
        "name": "Ondura.Praesentation.pptx",
        "description": "PowerPoint-Präsentation",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": [
          "odt"
        ],
        "name": "Ondura.Text.odt",
        "description": "OpenDocument-Text",
        "role": "Editor",
        "mimeType": "application/vnd.oasis.opendocument.text"
      },
      {
        "ext": [
          "ods"
        ],
        "name": "Ondura.Tabellen.ods",
        "description": "OpenDocument-Tabelle",
        "role": "Editor",
        "mimeType": "application/vnd.oasis.opendocument.spreadsheet"
      },
      {
        "ext": [
          "odp"
        ],
        "name": "Ondura.Praesentation.odp",
        "description": "OpenDocument-Präsentation",
        "role": "Editor",
        "mimeType": "application/vnd.oasis.opendocument.presentation"
      }
    ],
    "license": "GPL-3.0-or-later"
  }
}
