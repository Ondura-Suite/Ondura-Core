[Desktop Entry]
Type=Application
Name=Ondura Sheets
Name[de]=Ondura Tabellen
Name[fr]=Ondura Tableur
GenericName=Spreadsheet
GenericName[de]=Tabellenkalkulation
GenericName[fr]=Tableur
Comment=Calculate and edit spreadsheets (Excel format .xlsx, OpenDocument .ods)
Comment[de]=Tabellen berechnen und bearbeiten (Excel-Format .xlsx, OpenDocument .ods)
Comment[fr]=Calculer et modifier des feuilles de calcul (format Excel .xlsx, OpenDocument .ods)
Exec=ondura --app sheets %f
Icon=ondura-sheets
Terminal=false
Categories=Office;Spreadsheet;
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.oasis.opendocument.spreadsheet;
Keywords=tabelle;excel;xlsx;kalkulation;spreadsheet;rechnen;ods;opendocument;
StartupWMClass=ondura
