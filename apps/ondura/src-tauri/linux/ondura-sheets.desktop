[Desktop Entry]
Type=Application
Name=Ondura Tabellen
GenericName=Tabellenkalkulation
Comment=Tabellen berechnen und bearbeiten (Excel-Format .xlsx, OpenDocument .ods)
Exec=ondura --app sheets %f
Icon=ondura-sheets
Terminal=false
Categories=Office;Spreadsheet;
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.oasis.opendocument.spreadsheet;
Keywords=tabelle;excel;xlsx;kalkulation;spreadsheet;rechnen;ods;opendocument;
StartupWMClass=ondura
