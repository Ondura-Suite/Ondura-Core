[Desktop Entry]
Type=Application
Name=Ondura Slides
Name[de]=Ondura Präsentation
Name[fr]=Ondura Présentation
GenericName=Presentation
GenericName[de]=Präsentation
GenericName[fr]=Présentation
Comment=Create and present slide shows (PowerPoint format .pptx, OpenDocument .odp)
Comment[de]=Präsentationen erstellen und vorführen (PowerPoint-Format .pptx, OpenDocument .odp)
Comment[fr]=Créer et présenter des diaporamas (format PowerPoint .pptx, OpenDocument .odp)
Exec=ondura-slides --app slides %f
Icon=ondura-slides
Terminal=false
Categories=Office;Presentation;
MimeType=application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.oasis.opendocument.presentation;
Keywords=präsentation;powerpoint;pptx;folien;vortrag;slides;odp;opendocument;
StartupWMClass=ondura-slides
