[Desktop Entry]
Type=Application
Name=Ondura Text
Name[de]=Ondura Text
Name[fr]=Ondura Texte
GenericName=Word Processor
GenericName[de]=Textverarbeitung
GenericName[fr]=Traitement de texte
Comment=Write and edit documents (Word format .docx, OpenDocument .odt)
Comment[de]=Dokumente schreiben und bearbeiten (Word-Format .docx, OpenDocument .odt)
Comment[fr]=Rédiger et modifier des documents (format Word .docx, OpenDocument .odt)
Exec=ondura-text --app text %f
Icon=ondura-text
Terminal=false
Categories=Office;WordProcessor;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.oasis.opendocument.text;
Keywords=text;word;docx;dokument;brief;textverarbeitung;odt;opendocument;
StartupWMClass=ondura-text
